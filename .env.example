# Backend: copy to repository-root .env. Never expose service role to Vite.
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPPORT_URL=
SUPPORT_TEXT=Cảm ơn bạn đã đồng hành cùng Hội Vào Hang.
SPONSOR_NAME=
STORE_TIMEZONE=Asia/Ho_Chi_Minh

# Enable FC Barcelona archive image previews where the usage rights are in place.
BARCA_ARCHIVE_PHOTOS=0

# Frontend: copy these values to apps/web/.env.local. Publishable key is public.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Leave blank for same-origin Vite/reverse proxy. Use HTTPS origins in production.
VITE_BACKEND_URL=
VITE_WEBSOCKET_URL=
VITE_SERVER_URL=
# Public site origin; callback paths are appended automatically.
VITE_AUTH_REDIRECT_URL=http://localhost:5173
# Keep false until manual identity linking is enabled and verified on target project.
VITE_IDENTITY_LINKING_ENABLED=false
